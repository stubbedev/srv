# mkcert binary built from submodule and generated version file — produced by make mkcert
internal/mkcert/bin/
internal/mkcert/version.go

# Go vendor directory — dependencies fetched by go mod or Nix
vendor/

# Build artifacts
srv
main
deploy
*.exe

# Editor files
*.swp
*~
.idea/
.vscode/

# OS files
.DS_Store

# MkDocs output (`just docs-build`)
/site/

# e2e/run.sh state: temp dirs shared with the host engine, Go caches
/.e2e/

# Nix build output — the ./result symlink `nix build` creates; a bare pattern
# because `result/` would not match it (a symlink is not a directory).
result
