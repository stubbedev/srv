# Dev/test image: run the whole test suite inside a container instead of on
# the host, so nothing a test execs (sudo steps, trust stores, resolv.conf
# probes, service units) can ever reach the developer's machine.
#
# Built and run through compose.yaml (service `dev`, profile `dev`):
#
#   docker compose --profile dev up -d --build
#   docker compose --profile dev exec dev go test ./...
#   docker compose --profile dev down
#
# e2e/run.sh runs the e2e suite in this same image (`just test-e2e`).
#
# The dev user (uid 1000) matches a typical host login, so files the test
# run writes stay owned by the host user; passwordless sudo mirrors the
# container's root access for code paths that literally exec sudo.
FROM docker:29-cli AS dockercli

FROM golang:1.27-trixie

# The engine CLIs drive the host's engine through its mounted socket: the
# docker CLI and its Compose v2 plugin come from the official image (Debian's
# docker.io ships no Compose v2), and podman runs as a remote client
# (CONTAINER_HOST) whose `podman compose` delegates to that same plugin.
# golangci-lint is pinned to the exact version CI installs, so local runs in
# the container and CI can never disagree about what passes.
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
RUN apt-get update \
 && apt-get install -y --no-install-recommends sudo podman ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && GOBIN=/usr/local/bin go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.14.0 \
 && useradd -m -u 1000 dev \
 && echo 'dev ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/dev \
 && chmod 440 /etc/sudoers.d/dev

USER dev
ENV GOCACHE=/gocache
WORKDIR /work
